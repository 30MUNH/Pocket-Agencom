generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum UserRole {
  user
  staff
  admin
}

enum AccountStatus {
  active
  inactive
  banned
  archived
}

enum PlanStatus {
  draft
  saved
  reviewed
  approved
  need_revision
}

enum TemplateType {
  social_post
  banner
  video_script
  playbook
  checklist
}

enum TemplateStatus {
  active
  inactive
}

enum TicketStatus {
  open
  in_progress
  resolved
  escalated
  closed
}

enum TicketCategory {
  account
  marketing_plan
  payment
  technical
  other
}

enum NotificationType {
  system
  plan
  support
}

enum MediaAssetSourceKind {
  legacy_unverified
  legacy_internal_verified
  external_url
  private_storage
}

enum MediaAssetLifecycleState {
  active
  deleting
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  passwordHash String        @map("password_hash")
  phone        String?
  avatarUrl    String?       @map("avatar_url")
  avatarMediaAssetId Int?    @map("avatar_media_asset_id")
  role         UserRole      @default(user)
  status       AccountStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")

  businessProfile  BusinessProfile?
  marketingPlans   MarketingPlan[]  @relation("UserPlans")
  reviewedPlans    MarketingPlan[]  @relation("ReviewedPlans")
  createdTemplates Template[]
  tickets          SupportTicket[]  @relation("UserTickets")
  assignedTickets  SupportTicket[]  @relation("StaffTickets")
  notifications    Notification[]
  socialPlatforms  SocialPlatform[]
  scheduledPosts   ScheduledPost[]
  mediaAssets      MediaAsset[] @relation("MediaAssetOwner")
  avatarMediaAsset MediaAsset?  @relation("UserAvatarAsset", fields: [id, avatarMediaAssetId], references: [userId, id], onDelete: Restrict)
  aiQuotaUsage     AiQuotaUsage[]
  paymentOrders    PaymentOrder[]
  subscription     UserSubscription?
  subscriptionUsage SubscriptionUsage[]

  @@map("users")
}

model PaymentOrder {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         Int       @map("user_id")
  planId         String    @map("plan_id")
  paymentCode    String    @unique @map("payment_code")
  amount         Int
  durationDays   Int       @map("duration_days")
  status         String    @default("pending")
  bank           String
  accountNumber  String    @map("account_number")
  virtualAccount String    @map("virtual_account")
  accountName    String    @map("account_name")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  paidAt         DateTime? @map("paid_at")
  bankPaidAt     DateTime? @map("bank_paid_at")

  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  events         SepayWebhookEvent[]
  subscriptions  UserSubscription[]

  @@index([userId, createdAt])
  @@map("payment_orders")
}

model UserSubscription {
  userId      Int      @id @map("user_id")
  planId      String   @map("plan_id")
  startsAt    DateTime @map("starts_at")
  expiresAt   DateTime @map("expires_at")
  lastOrderId String   @unique @map("last_order_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  lastOrder PaymentOrder @relation(fields: [lastOrderId], references: [id], onDelete: Restrict)

  @@map("user_subscriptions")
}

model SepayWebhookEvent {
  transactionId  String    @id @map("transaction_id")
  orderId        String?   @map("order_id") @db.Uuid
  paymentCode    String?   @map("payment_code")
  amount         BigInt
  accountNumber  String    @map("account_number")
  virtualAccount String?   @map("virtual_account")
  referenceCode  String?   @map("reference_code")
  transactionAt  DateTime  @map("transaction_at")
  outcome        String
  createdAt      DateTime  @default(now()) @map("created_at")

  order PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([outcome, createdAt])
  @@map("sepay_webhook_events")
}

model SubscriptionUsage {
  userId    Int      @map("user_id")
  periodKey String   @map("period_key")
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, periodKey])
  @@map("subscription_usage")
}

model BusinessProfile {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique @map("user_id")
  businessName           String?  @map("business_name")
  businessType           String   @map("business_type")
  productDescription     String   @map("product_description")
  targetCustomer         String   @map("target_customer")
  marketingGoal          String?  @map("marketing_goal")
  budgetRange            String?  @map("budget_range")
  location               String?
  usp                    String?  @map("usp")
  brandVoice             String?  @map("brand_voice")
  priceRange             String?  @map("price_range")
  bestSellingProduct     String?  @map("best_selling_product")
  monthlyMarketingBudget String?  @map("monthly_marketing_budget")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  marketingPlans  MarketingPlan[]
  socialPlatforms SocialPlatform[]

  @@unique([userId, id])
  @@map("business_profiles")
}

model MarketingPlan {
  id                 Int        @id @default(autoincrement())
  userId             Int        @map("user_id")
  businessProfileId  Int        @map("business_profile_id")
  goal               String
  campaignType       String?    @map("campaign_type")
  budget             Decimal?
  contentIdeas       String?    @map("content_ideas")
  videoScripts       String?    @map("video_scripts")
  checklist          String?
  playbook           String?
  seoKeywords        String?    @map("seo_keywords")
  budgetBreakdown    String?    @map("budget_breakdown")
  deploymentChannels String?    @map("deployment_channels")
  existingResources  String?    @map("existing_resources")
  campaignReason     String?    @map("campaign_reason")
  hasLegacyContent   Boolean    @default(false) @map("has_legacy_content")
  status             PlanStatus @default(saved)
  reviewedById       Int?       @map("reviewed_by")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @default(now()) @updatedAt @map("updated_at")

  user            User            @relation("UserPlans", fields: [userId], references: [id])
  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id])
  reviewedBy      User?           @relation("ReviewedPlans", fields: [reviewedById], references: [id])
  expenses        Expense[]
  mediaAssets     MarketingPlanAsset[]

  @@unique([userId, id])
  @@map("marketing_plans")
}

model Template {
  id           Int            @id @default(autoincrement())
  title        String
  category     String?
  type         TemplateType
  description  String?
  fileUrl      String?        @map("file_url")
  previewImage String?        @map("preview_image")
  createdById  Int            @map("created_by")
  status       TemplateStatus @default(active)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("templates")
}

model SupportTicket {
  id              Int            @id @default(autoincrement())
  userId          Int            @map("user_id")
  assignedStaffId Int?           @map("assigned_staff_id")
  subject         String
  message         String
  category        TicketCategory @default(other)
  status          TicketStatus   @default(open)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")

  user          User  @relation("UserTickets", fields: [userId], references: [id])
  assignedStaff User? @relation("StaffTickets", fields: [assignedStaffId], references: [id])

  @@map("support_tickets")
}

model KnowledgeBase {
  id        String                      @id @default(uuid()) @db.Uuid
  content   String                      @db.Text
  metadata  Json?
  embedding Unsupported("vector(768)")?
  scope               String    @default("unclassified")
  ownerUserId         Int?      @map("owner_user_id")
  businessProfileId   Int?      @map("business_profile_id")
  approvedByUserId    Int?      @map("approved_by_user_id")
  approvedAt          DateTime? @map("approved_at")
  embeddingProvider   String?   @map("embedding_provider")
  embeddingModel      String?   @map("embedding_model")
  embeddingVersion    String?   @map("embedding_version")
  embeddingDimensions Int?      @map("embedding_dimensions")
  createdAt DateTime                    @default(now()) @map("created_at")

  @@index([scope, ownerUserId, businessProfileId])
  @@index([scope, embeddingModel, embeddingVersion])
  @@map("knowledge_base")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int              @map("user_id")
  title     String
  message   String?
  type      NotificationType @default(system)
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model SocialPlatform {
  id                String   @id @default(uuid()) @db.Uuid
  userId            Int      @map("user_id")
  platform          String // 'tiktok', 'facebook', 'shopee', etc.
  platformType      String?  @default("social") @map("platform_type") // 'social', 'ecommerce', 'custom'
  url               String
  followersCount    Int      @map("followers_count")
  engagementRate    Float    @map("engagement_rate")
  metrics           Json?    @default("[]")
  aiInsight         String?  @map("ai_insight") @db.Text
  businessProfileId Int      @map("business_profile_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessProfile BusinessProfile @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)

  @@map("social_platforms")
}

enum PostStatus {
  draft
  pending_approval
  approved
  published
}

model ScheduledPost {
  id                Int        @id @default(autoincrement())
  userId            Int        @map("user_id")
  businessProfileId Int?       @map("business_profile_id")
  title             String
  content           String     @db.Text
  imageUrl          String?    @map("image_url")
  mediaAssetId      Int?       @map("media_asset_id")
  platform          String // 'Facebook', 'TikTok', 'Instagram', 'Zalo', etc.
  scheduledTime     DateTime?  @map("scheduled_time")
  status            PostStatus @default(pending_approval)
  isGoldenTime      Boolean    @default(false) @map("is_golden_time")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation("ScheduledPostAsset", fields: [userId, mediaAssetId], references: [userId, id], onDelete: Restrict)

  @@map("scheduled_posts")
}

model AiQuotaUsage {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  dateKey   String   @map("date_key") // 'YYYY-MM-DD'
  type      String   // 'text' or 'image'
  count     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey, type])
  @@map("ai_quota_usage")
}

model MediaAsset {
  id                    Int                     @id @default(autoincrement())
  userId                Int                     @map("user_id")
  businessProfileId     Int?                    @map("business_profile_id")
  name                  String
  url                   String?
  sourceKind            MediaAssetSourceKind    @default(legacy_unverified) @map("source_kind")
  storageBucket         String?                 @map("storage_bucket")
  storagePath           String?                 @map("storage_path")
  fileType              String                  @map("file_type")
  sizeBytes             Int?                    @map("size_bytes")
  lifecycleState        MediaAssetLifecycleState @default(active) @map("lifecycle_state")
  deletionOperationId   String?                 @unique @map("deletion_operation_id")
  deletionStartedAt     DateTime?               @map("deletion_started_at")
  deletionLastAttemptAt DateTime?               @map("deletion_last_attempt_at")
  deletionAttemptCount  Int                     @default(0) @map("deletion_attempt_count")
  deletionLastError     String?                 @map("deletion_last_error")
  createdAt             DateTime                @default(now()) @map("created_at")

  user                 User                 @relation("MediaAssetOwner", fields: [userId], references: [id], onDelete: Cascade)
  avatarFor            User[]               @relation("UserAvatarAsset")
  scheduledPosts       ScheduledPost[]      @relation("ScheduledPostAsset")
  marketingPlanAssets  MarketingPlanAsset[]
  accessLeases         MediaAssetAccessLease[]

  @@unique([userId, id])
  @@unique([storageBucket, storagePath])
  @@index([userId, lifecycleState])
  @@map("media_assets")
}

model MarketingPlanAsset {
  id              Int          @id @default(autoincrement())
  userId          Int          @map("user_id")
  marketingPlanId Int          @map("marketing_plan_id")
  mediaAssetId    Int          @map("media_asset_id")
  purpose         String       @default("attachment")
  createdAt       DateTime     @default(now()) @map("created_at")

  marketingPlan MarketingPlan @relation(fields: [userId, marketingPlanId], references: [userId, id], onDelete: Cascade)
  mediaAsset    MediaAsset    @relation(fields: [userId, mediaAssetId], references: [userId, id], onDelete: Restrict)

  @@unique([marketingPlanId, mediaAssetId])
  @@index([userId, mediaAssetId])
  @@map("marketing_plan_assets")
}

model MediaAssetAccessLease {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  mediaAssetId Int     @map("media_asset_id")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  mediaAsset MediaAsset @relation(fields: [userId, mediaAssetId], references: [userId, id], onDelete: Cascade)

  @@index([mediaAssetId, expiresAt])
  @@map("media_asset_access_leases")
}

model Expense {
  id              Int         @id @default(autoincrement())
  marketingPlanId Int         @map("marketing_plan_id")
  expenseType     ExpenseType @map("expense_type")
  amount          Decimal
  note            String?
  date            DateTime    @default(now())
  createdAt       DateTime    @default(now()) @map("created_at")

  marketingPlan MarketingPlan @relation(fields: [marketingPlanId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

enum ExpenseType {
  Ads
  Custom
}

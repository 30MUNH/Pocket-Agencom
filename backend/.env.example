# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (Text, Vision, & 768-dim RAG Embeddings. Supports comma-separated keys for auto-rotation: key1,key2,...)
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=

# AI Provider Configuration (Multi-Provider: Groq, OpenRouter, Gemini, fal.ai)
# Primary fast & cost-effective text LLM (Groq Cloud)
GROQ_API_KEY=
GROQ_MODEL=

# Fallback & Multimodal Gateway (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_IMAGE_MODEL=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=

# Optional Provider Overrides ('groq' | 'openrouter' | 'gemini')
AI_TEXT_PROVIDER=groq
AI_IMAGE_PROVIDER=cloudflare

# Free-only protection
FREE_ONLY_MODE=true
AI_ALLOW_PAID_MODELS=false

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
DEMO_AUTH_ENABLED=false

# Network
PORT=
FRONTEND_URL=

# ScrapingAnt
SCRAPING_API_KEY=

# SePay bank webhook: shared official MBBank VA from your dashboard.
# Confirm these non-secret account details before accepting real payments.
SEPAY_BANK=MBBank
SEPAY_ACCOUNT_NUMBER=0911266029
SEPAY_ACCOUNT_NAME=LE HUU DUC DUY
SEPAY_VIRTUAL_ACCOUNT=VQRQAMZKV7190
# apikey: Authorization: Apikey <secret>; hmac: X-SePay-Signature + Timestamp.
SEPAY_WEBHOOK_AUTH=apikey
# At least 32 random characters; copy the SAME secret into SePay's webhook auth.
# This is a webhook secret, NOT the SePay bank API token. Never prefix with VITE_.
SEPAY_WEBHOOK_SECRET=

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=

# Supabase Storage Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (Text, Vision, & 768-dim RAG Embeddings)
GEMINI_API_KEY=
GEMINI_MODEL=

# AI Provider Configuration (Multi-Provider: Groq, OpenRouter, Gemini, fal.ai)
# Primary fast & cost-effective text LLM (Groq Cloud)
GROQ_API_KEY=
GROQ_MODEL=

# Fallback & Multimodal Gateway (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_IMAGE_MODEL=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=

# Optional Provider Overrides ('groq' | 'openrouter' | 'gemini')
AI_TEXT_PROVIDER=groq
AI_IMAGE_PROVIDER=cloudflare

# Free-only protection
FREE_ONLY_MODE=true
AI_ALLOW_PAID_MODELS=false

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Network
PORT=
FRONTEND_URL=

# ScrapingAnt
SCRAPING_API_KEY=

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Supabase Storage Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==============================================================================
# STRICT ZERO-COST FREE-TIER AI INFRASTRUCTURE ($0 Budget Constraint)
# ==============================================================================
# When FREE_ONLY_MODE=true, the system strictly enforces $0 cost contracts:
# - Rejects paid model invocations
# - Blocks paid credit consumption
# - Enforces daily user quotas (50 text / 20 images)
FREE_ONLY_MODE=true
AI_ALLOW_PAID_MODELS=false
AI_DAILY_TEXT_QUOTA_PER_USER=50
AI_DAILY_IMAGE_QUOTA_PER_USER=20

# Primary Free Text LLM (Groq Cloud Free Tier)
# Model: openai/gpt-oss-120b (Replaces deprecated llama-3.3-70b-versatile)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Fallback Free Text LLM (OpenRouter Free Router or :free models)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Zero-Cost Image Generation (Cloudflare Workers AI Free Tier Neurons)
# Model: @cf/black-forest-labs/flux-1-schnell
# Auto-cropped to 1:1, 4:5, 9:16, 16:9 via sharp
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Google Gemini API Key (Free Tier Text, Vision, & 768-dim RAG gemini-embedding-2)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Active Provider Priority ('groq' | 'openrouter' | 'gemini')
AI_TEXT_PROVIDER=groq
AI_IMAGE_PROVIDER=cloudflare

# Paid Provider Keys (Only used if FREE_ONLY_MODE=false and AI_ALLOW_PAID_MODELS=true)
# FAL_KEY=
# FAL_MODEL=fal-ai/flux/schnell

# Authentication
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Network & Server Ports
PORT=5000
FRONTEND_URL=http://localhost:5173,https://your-frontend-domain.com

# Web Scraping API (ScrapingAnt)
SCRAPING_API_KEY=your-scrapingant-api-key-here